# Google AI Studio(aistudio.google.com)에서 받은 키를 넣고 파일 이름을 .env로 바꾸세요
GEMINI_API_KEY=
# 모델이 없어졌다는 오류가 나면 AI Studio에서 무료 Flash 모델 이름을 확인해 바꾸세요
GEMINI_MODEL=gemini-flash-lite-latest
# ChatGPT로 바꾸려면(선택): platform.openai.com → API keys에서 받은 키. 넣으면 곰두리 대화는 OpenAI를 쓰고, 비워 두면 Gemini를 씀
# (결제 수단이 등록된 API 키가 필요해요 · ChatGPT Plus 구독과는 별개)
OPENAI_API_KEY=
# 계정에서 쓸 수 있는 모델 이름 (비우면 gpt-4o-mini)
OPENAI_MODEL=
# 공유 DB(선택): Supabase 프로젝트 → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 서비스 전체 하루 AI 호출 상한 (AI Studio 무료 한도보다 낮게)
GEMINI_DAILY_CAP=500
